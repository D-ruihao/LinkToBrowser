<ui:FluentWindow x:Class="LinkToBrowser.Views.CustomBrowserDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource S_CustomWinTitle}"
                 Icon="pack://application:,,,/LinkToBrowser;component/src/Assets/LinkToBrowser.ico"
                 Width="500"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{DynamicResource S_CustomTitleBar}"
                     Icon="{ui:ImageIcon 'pack://application:,,,/LinkToBrowser;component/src/Assets/LinkToBrowser.png'}"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="20,8,20,20">
            <TextBlock Text="{DynamicResource S_CustomNameLabel}" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ui:TextBox x:Name="NameBox" PlaceholderText="{DynamicResource S_CustomNameHint}" Margin="0,0,0,12" />

            <TextBlock Text="{DynamicResource S_CustomExeLabel}" FontWeight="SemiBold" Margin="0,0,0,6" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="ExeBox" Grid.Column="0" PlaceholderText="{DynamicResource S_CustomExeHint}" />
                <ui:Button Grid.Column="1" Content="{DynamicResource S_CustomBrowse}" Margin="8,0,0,0" Click="BrowseExe_Click" />
            </Grid>

            <TextBlock Text="{DynamicResource S_CustomArgsLabel}" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Text="{DynamicResource S_CustomArgsHint}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6" />
            <ui:TextBox x:Name="ArgsBox" PlaceholderText="{DynamicResource S_CustomArgsPlaceholder}" Margin="0,0,0,8" />

            <WrapPanel Margin="0,0,0,12">
                <ui:Button Content="{DynamicResource S_CustomPresetProfile}" Appearance="Secondary" Margin="0,0,8,0" Click="PresetProfile_Click" />
                <ui:Button Content="{DynamicResource S_CustomPresetIncognito}" Appearance="Secondary" Click="PresetIncognito_Click" />
            </WrapPanel>

            <ui:InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="False" Severity="Error" Margin="0,0,0,12" />

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" Content="{DynamicResource S_CustomTestLaunch}" Appearance="Secondary" Click="TestLaunch_Click" />
                <ui:Button Grid.Column="2" Content="{DynamicResource S_CustomCancel}" Margin="0,0,8,0" Click="Cancel_Click" />
                <ui:Button Grid.Column="3" Content="{DynamicResource S_CustomSave}" Appearance="Primary" Click="Save_Click" />
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
