<ui:FluentWindow x:Class="LinkToBrowser.Views.CustomBrowserDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="添加 / 编辑自定义浏览器"
                 Width="500"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="自定义浏览器 / 启动参数" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="20,8,20,20">
            <TextBlock Text="显示名称" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ui:TextBox x:Name="NameBox" PlaceholderText="例如：比特浏览器内核 / Chrome 工作号" Margin="0,0,0,12" />

            <TextBlock Text="可执行文件路径 (.exe)" FontWeight="SemiBold" Margin="0,0,0,6" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="ExeBox" Grid.Column="0" PlaceholderText="选择或粘贴浏览器 .exe 路径" />
                <ui:Button Grid.Column="1" Content="浏览..." Margin="8,0,0,0" Click="BrowseExe_Click" />
            </Grid>

            <TextBlock Text="启动参数模板（可选）" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Text="可用 {url} 占位符；留空或未写 {url} 时会在末尾自动追加引号包裹的链接。"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6" />
            <ui:TextBox x:Name="ArgsBox" PlaceholderText="例如：--profile-directory=&quot;Profile 1&quot; {url}" Margin="0,0,0,8" />

            <WrapPanel Margin="0,0,0,12">
                <ui:Button Content="预设: Chrome 多用户" Appearance="Secondary" Margin="0,0,8,0" Click="PresetProfile_Click" />
                <ui:Button Content="预设: 隐身模式" Appearance="Secondary" Click="PresetIncognito_Click" />
            </WrapPanel>

            <ui:InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="False" Severity="Error" Margin="0,0,0,12" />

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" Content="测试启动" Appearance="Secondary" Click="TestLaunch_Click" />
                <ui:Button Grid.Column="2" Content="取消" Margin="0,0,8,0" Click="Cancel_Click" />
                <ui:Button Grid.Column="3" Content="保存" Appearance="Primary" Click="Save_Click" />
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
