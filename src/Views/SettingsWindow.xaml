<ui:FluentWindow x:Class="LinkToBrowser.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource S_SettingsWindowTitle}"
                 Icon="pack://application:,,,/LinkToBrowser;component/src/Assets/LinkToBrowser.ico"
                 Width="920"
                 Height="640"
                 MinWidth="800"
                 MinHeight="520"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="LinkToBrowser"
                     Icon="{ui:ImageIcon 'pack://application:,,,/LinkToBrowser;component/src/Assets/LinkToBrowser.png'}"
                     ShowMaximize="True"
                     ShowMinimize="True"
                     Height="38" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航栏 -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="10,8,10,12">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top">
                        <ui:Button x:Name="NavGeneralBtn"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Content="{DynamicResource S_NavGeneral}"
                                   Icon="{ui:SymbolIcon Settings20}"
                                   Appearance="Secondary"
                                   Margin="0,0,0,4"
                                   Click="NavGeneral_Click" />
                        <ui:Button x:Name="NavRulesBtn"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Content="{DynamicResource S_NavRules}"
                                   Icon="{ui:SymbolIcon Filter20}"
                                   Appearance="Transparent"
                                   Margin="0,0,0,4"
                                   Click="NavRules_Click" />
                        <ui:Button x:Name="NavBrowsersBtn"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Content="{DynamicResource S_NavBrowsers}"
                                   Icon="{ui:SymbolIcon Globe20}"
                                   Appearance="Transparent"
                                   Margin="0,0,0,4"
                                   Click="NavBrowsers_Click" />
                        <ui:Button x:Name="NavAboutBtn"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Content="{DynamicResource S_NavAbout}"
                                   Icon="{ui:SymbolIcon Info20}"
                                   Appearance="Transparent"
                                   Click="NavAbout_Click" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <Separator Margin="4,0,4,8" />
                        <ui:Button HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Content="{DynamicResource S_OpenConfig}"
                                   Icon="{ui:SymbolIcon Open20}"
                                   Appearance="Transparent"
                                   Margin="0,0,0,4"
                                   Click="OpenConfig_Click" />
                        <ui:Button HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Content="{DynamicResource S_OpenLogs}"
                                   Icon="{ui:SymbolIcon FolderOpen20}"
                                   Appearance="Transparent"
                                   Click="OpenLogs_Click" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 右侧设置主体 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="24,10,24,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PageTitleText" Text="{DynamicResource S_NavGeneral}" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="SavedBadgeText"
                               Grid.Column="1"
                               Text="{DynamicResource S_SavedBadge}"
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Opacity="0" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,4,24,24">
                    <Grid>
                        <!-- 页 1：常规 -->
                        <StackPanel x:Name="GeneralPage">
                            <ui:InfoBar x:Name="RegStatusBar" IsOpen="True" IsClosable="False" Margin="0,0,0,12" />

                            <Border CornerRadius="8"
                                    Padding="16,12"
                                    Margin="0,0,0,18"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{DynamicResource S_RegCardTitle}" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock x:Name="RegPathSubtitle"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ui:Button x:Name="RegisterBtn"
                                               Grid.Column="1"
                                               Content="{DynamicResource S_RegBtnUpdatePath}"
                                               Appearance="Primary"
                                               Margin="0,0,8,0"
                                               Click="Register_Click" />
                                    <ui:Button Grid.Column="2"
                                               Content="{DynamicResource S_RegBtnOpenDefaultApps}"
                                               Appearance="Secondary"
                                               Click="OpenDefaultApps_Click" />
                                </Grid>
                            </Border>

                            <TextBlock Text="{DynamicResource S_GlobalModeHeader}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />

                            <!-- 模式 1：Windows 原生 -->
                            <Border CornerRadius="8"
                                    Padding="14,11"
                                    Margin="0,0,0,6"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    MouseLeftButtonUp="ModeNativeCard_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="ModeNativeRadio"
                                                 Grid.Column="0"
                                                 HorizontalContentAlignment="Stretch"
                                                 GroupName="GlobalMode"
                                                 Checked="ModeRadio_Changed">
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock Text="{DynamicResource S_ModeNativeTitle}" FontWeight="SemiBold" FontSize="13.5" />
                                            <TextBlock Text="{DynamicResource S_ModeNativeDesc}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <ComboBox x:Name="OriginalProgIdCombo"
                                              Grid.Column="1"
                                              Width="220"
                                              MaxWidth="220"
                                              Margin="8,0,8,0"
                                              VerticalAlignment="Center"
                                              DisplayMemberPath="Display"
                                              SelectionChanged="OriginalProgIdCombo_SelectionChanged" />
                                    <ui:Button Grid.Column="2"
                                               Content="{DynamicResource S_BtnRestoreDefault}"
                                               Appearance="Secondary"
                                               VerticalAlignment="Center"
                                               Click="RestoreSystemDefault_Click" />
                                </Grid>
                            </Border>

                            <!-- 模式 2：默认指定浏览器 -->
                            <Border CornerRadius="8"
                                    Padding="14,11"
                                    Margin="0,0,0,6"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    MouseLeftButtonUp="ModeDefaultCard_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="ModeDefaultRadio"
                                                 Grid.Column="0"
                                                 HorizontalContentAlignment="Stretch"
                                                 GroupName="GlobalMode"
                                                 Checked="ModeRadio_Changed">
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock Text="{DynamicResource S_ModeDefaultTitle}" FontWeight="SemiBold" FontSize="13.5" />
                                            <TextBlock Text="{DynamicResource S_ModeDefaultDesc}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <ComboBox x:Name="DefaultBrowserCombo"
                                              Grid.Column="1"
                                              Width="210"
                                              MaxWidth="210"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              DisplayMemberPath="Name"
                                              SelectionChanged="DefaultBrowserCombo_SelectionChanged" />
                                </Grid>
                            </Border>

                            <!-- 模式 3：弹出浏览器选择界面 -->
                            <Border CornerRadius="8"
                                    Padding="14,11"
                                    Margin="0,0,0,6"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    MouseLeftButtonUp="ModePickerCard_Click">
                                <RadioButton x:Name="ModePickerRadio"
                                             HorizontalContentAlignment="Stretch"
                                             GroupName="GlobalMode"
                                             Checked="ModeRadio_Changed">
                                    <StackPanel Margin="4,0,0,0">
                                        <TextBlock Text="{DynamicResource S_ModePickerTitle}" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock Text="{DynamicResource S_ModePickerDesc}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </RadioButton>
                            </Border>

                            <!-- 模式 4：默认复制到剪贴板 -->
                            <Border CornerRadius="8"
                                    Padding="14,11"
                                    Margin="0,0,0,6"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    MouseLeftButtonUp="ModeClipboardCard_Click">
                                <RadioButton x:Name="ModeClipboardRadio"
                                             HorizontalContentAlignment="Stretch"
                                             GroupName="GlobalMode"
                                             Checked="ModeRadio_Changed">
                                    <StackPanel Margin="4,0,0,0">
                                        <TextBlock Text="{DynamicResource S_ModeClipboardTitle}" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock Text="{DynamicResource S_ModeClipboardDesc}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </RadioButton>
                            </Border>

                            <!-- 模式 5：最近聚焦的浏览器 -->
                            <Border CornerRadius="8"
                                    Padding="14,11"
                                    Margin="0,0,0,16"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    MouseLeftButtonUp="ModeRecentCard_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="ModeRecentRadio"
                                                 Grid.Column="0"
                                                 HorizontalContentAlignment="Stretch"
                                                 GroupName="GlobalMode"
                                                 Checked="ModeRadio_Changed">
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock Text="{DynamicResource S_ModeRecentTitle}" FontWeight="SemiBold" FontSize="13.5" />
                                            <TextBlock Text="{DynamicResource S_ModeRecentDesc}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <ComboBox x:Name="RecentFallbackCombo"
                                              Grid.Column="1"
                                              Width="210"
                                              MaxWidth="210"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              SelectionChanged="RecentFallbackCombo_SelectionChanged" />
                                </Grid>
                            </Border>

                            <TextBlock Text="{DynamicResource S_BehaviorHeader}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />

                            <ui:CardControl Margin="0,0,0,6">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource S_ShowClipPopupTitle}" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock Text="{DynamicResource S_ShowClipPopupDesc}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="ShowClipPopupToggle" Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,6">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource S_AutoCloseTitle}" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock Text="{DynamicResource S_AutoCloseDesc}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox x:Name="AutoCloseCombo" Width="150" SelectionChanged="AutoCloseCombo_SelectionChanged" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,6">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource S_ModifierTitle}" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock Text="{DynamicResource S_ModifierDesc}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox x:Name="ModifierCombo" Width="150" SelectionChanged="ModifierCombo_SelectionChanged" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,6">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource S_ChromiumTitle}" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock Text="{DynamicResource S_ChromiumDesc}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="ChromiumProfilesToggle" Checked="ChromiumProfilesToggle_Changed" Unchecked="ChromiumProfilesToggle_Changed" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,6">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource S_StripTrackingTitle}" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock Text="{DynamicResource S_StripTrackingDesc}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="StripTrackingToggle" Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,6">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource S_EnableCdpTitle}" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock Text="{DynamicResource S_EnableCdpDesc}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="EnableCdpToggle" Checked="ChromiumProfilesToggle_Changed" Unchecked="ChromiumProfilesToggle_Changed" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,6">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource S_ThemeTitle}" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock Text="{DynamicResource S_ThemeDesc}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox x:Name="ThemeCombo" Width="150" SelectionChanged="ThemeCombo_SelectionChanged" />
                            </ui:CardControl>

                            <ui:CardControl>
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource S_LanguageTitle}" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock Text="{DynamicResource S_LanguageDesc}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox x:Name="LanguageCombo" Width="150" SelectionChanged="LanguageCombo_SelectionChanged" />
                            </ui:CardControl>
                        </StackPanel>

                        <!-- 页 2：分流规则 -->
                        <StackPanel x:Name="RulesPage" Visibility="Collapsed">
                            <ui:CardControl Margin="0,0,0,12">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource S_RulesEnableTitle}" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock Text="{DynamicResource S_RulesEnableDesc}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="EnableRulesToggle" Checked="EnableRulesToggle_Changed" Unchecked="EnableRulesToggle_Changed" />
                            </ui:CardControl>

                            <WrapPanel Margin="0,0,0,10">
                                <ui:Button Content="{DynamicResource S_AddRule}"
                                           Icon="{ui:SymbolIcon Add20}"
                                           Appearance="Primary"
                                           Margin="0,0,8,6"
                                           Click="AddRule_Click" />
                                <ui:Button Content="{DynamicResource S_LoadSamples}"
                                           Icon="{ui:SymbolIcon ArrowSync20}"
                                           Appearance="Secondary"
                                           Margin="0,0,8,6"
                                           Click="LoadSampleRules_Click" />
                                <ui:Button Content="{DynamicResource S_ExportBackup}"
                                           Appearance="Secondary"
                                           Margin="0,0,8,6"
                                           Click="ExportConfig_Click" />
                                <ui:Button Content="{DynamicResource S_ImportBackup}"
                                           Appearance="Secondary"
                                           Margin="0,0,0,6"
                                           Click="ImportConfig_Click" />
                            </WrapPanel>

                            <Border CornerRadius="8"
                                    Padding="12,10"
                                    Margin="0,0,0,12"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <ui:TextBox x:Name="RuleTestBox"
                                                Icon="{ui:SymbolIcon Search20}"
                                                PlaceholderText="{DynamicResource S_RulesTestHint}"
                                                TextChanged="RuleTestBox_TextChanged" />
                                    <TextBlock x:Name="RuleTestResultText"
                                               FontSize="12"
                                               Margin="2,6,2,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <ItemsControl x:Name="RulesListControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8"
                                                Padding="12,10"
                                                Margin="0,0,0,6"
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="26" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,8,0"
                                                          Tag="{Binding}"
                                                          Click="ToggleRuleEnabled_Click" />

                                                <Grid Grid.Column="1" Width="20" Height="20" VerticalAlignment="Center">
                                                    <Image Source="{Binding Icon}" Width="20" Height="20" />
                                                    <ui:SymbolIcon Symbol="Globe20" Visibility="{Binding FallbackIconVisibility}" />
                                                </Grid>

                                                <StackPanel Grid.Column="2" Margin="8,0,12,0" VerticalAlignment="Center">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                                        <Border Grid.Column="1"
                                                                CornerRadius="4"
                                                                Padding="6,1"
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                            <TextBlock Text="{Binding MatchKindLabel}" FontSize="11" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Subtitle}"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Subtitle}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:Button Icon="{ui:SymbolIcon ArrowUp20}"
                                                               Appearance="Transparent"
                                                               ToolTip="{DynamicResource S_TipMoveUp}"
                                                               Tag="{Binding}"
                                                               Click="MoveRuleUp_Click" />
                                                    <ui:Button Icon="{ui:SymbolIcon ArrowDown20}"
                                                               Appearance="Transparent"
                                                               ToolTip="{DynamicResource S_TipMoveDown}"
                                                               Tag="{Binding}"
                                                               Margin="0,0,4,0"
                                                               Click="MoveRuleDown_Click" />
                                                    <ui:Button Icon="{ui:SymbolIcon Edit20}"
                                                               Appearance="Transparent"
                                                               ToolTip="{DynamicResource S_TipEdit}"
                                                               Tag="{Binding}"
                                                               Click="EditRule_Click" />
                                                    <ui:Button Icon="{ui:SymbolIcon Delete20}"
                                                               Appearance="Transparent"
                                                               ToolTip="{DynamicResource S_TipDelete}"
                                                               Tag="{Binding}"
                                                               Click="DeleteRule_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- 页 3：浏览器管理 -->
                        <StackPanel x:Name="BrowsersPage" Visibility="Collapsed">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{DynamicResource S_BrowsersDesc}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0" />
                                <ui:Button Grid.Column="1"
                                           Content="{DynamicResource S_Rescan}"
                                           Icon="{ui:SymbolIcon ArrowSync20}"
                                           Appearance="Secondary"
                                           Margin="0,0,8,0"
                                           Click="RescanBrowsers_Click" />
                                <ui:Button Grid.Column="2"
                                           Content="{DynamicResource S_AddCustom}"
                                           Icon="{ui:SymbolIcon Add20}"
                                           Appearance="Primary"
                                           Click="AddCustomBrowser_Click" />
                            </Grid>

                            <ItemsControl x:Name="BrowsersListControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8"
                                                Padding="12,10"
                                                Margin="0,0,0,6"
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Column="0" Width="22" Height="22" VerticalAlignment="Center">
                                                    <Image Source="{Binding Icon}" Width="22" Height="22" />
                                                    <ui:SymbolIcon Symbol="Globe20" Visibility="{Binding FallbackIconVisibility}" />
                                                </Grid>

                                                <StackPanel Grid.Column="1" Margin="8,0,12,0" VerticalAlignment="Center">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                                        <Border Grid.Column="1"
                                                                CornerRadius="4"
                                                                Padding="6,1"
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                            <TextBlock Text="{Binding KindLabel}" FontSize="11" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding CommandPreview}"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding CommandPreview}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:Button Icon="{ui:SymbolIcon ArrowUp20}"
                                                               Appearance="Transparent"
                                                               ToolTip="{DynamicResource S_TipMoveUp}"
                                                               Tag="{Binding}"
                                                               Click="MoveUp_Click" />
                                                    <ui:Button Icon="{ui:SymbolIcon ArrowDown20}"
                                                               Appearance="Transparent"
                                                               ToolTip="{DynamicResource S_TipMoveDown}"
                                                               Tag="{Binding}"
                                                               Margin="0,0,4,0"
                                                               Click="MoveDown_Click" />
                                                    <ui:Button Content="{Binding VisibilityButtonText}"
                                                               Appearance="Secondary"
                                                               Tag="{Binding}"
                                                               Margin="0,0,4,0"
                                                               Click="ToggleHidden_Click" />
                                                    <ui:Button Content="{DynamicResource S_BtnTest}"
                                                               Appearance="Secondary"
                                                               Tag="{Binding}"
                                                               Margin="0,0,4,0"
                                                               Click="TestBrowser_Click" />
                                                    <ui:Button Icon="{ui:SymbolIcon Edit20}"
                                                               Appearance="Transparent"
                                                               ToolTip="{DynamicResource S_TipEdit}"
                                                               Visibility="{Binding CustomActionVisibility}"
                                                               Tag="{Binding}"
                                                               Click="EditCustom_Click" />
                                                    <ui:Button Icon="{ui:SymbolIcon Delete20}"
                                                               Appearance="Transparent"
                                                               ToolTip="{DynamicResource S_TipDelete}"
                                                               Visibility="{Binding CustomActionVisibility}"
                                                               Tag="{Binding}"
                                                               Click="DeleteCustom_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- 页 4：关于与诊断 -->
                        <StackPanel x:Name="AboutPage" Visibility="Collapsed">
                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource S_DiagAssocTitle}" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock x:Name="DiagAssocText"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:Button Content="{DynamicResource S_BtnRefresh}" Appearance="Secondary" Click="RefreshDiag_Click" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource S_DiagConfigTitle}" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock x:Name="DiagConfigPathText"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="{DynamicResource S_BtnOpen}" Appearance="Secondary" Margin="0,0,8,0" Click="OpenConfig_Click" />
                                    <ui:Button Content="{DynamicResource S_Export}" Appearance="Secondary" Margin="0,0,8,0" Click="ExportConfig_Click" />
                                    <ui:Button Content="{DynamicResource S_Import}" Appearance="Secondary" Click="ImportConfig_Click" />
                                </StackPanel>
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource S_DiagLogTitle}" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock x:Name="DiagLogDirText"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="{DynamicResource S_BtnOpenDir}" Appearance="Secondary" Margin="0,0,8,0" Click="OpenLogs_Click" />
                                    <ui:Button Content="{DynamicResource S_BtnClearLogs}" Appearance="Secondary" Click="ClearLogs_Click" />
                                </StackPanel>
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource S_RestoreCardTitle}" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock Text="{DynamicResource S_RestoreCardDesc}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:Button Content="{DynamicResource S_BtnRestoreClean}" Appearance="Caution" Click="RestoreSystemDefault_Click" />
                            </ui:CardControl>

                            <Border CornerRadius="8"
                                    Padding="16,12"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock x:Name="AboutVersionText" Text="LinkToBrowser v2.1.1" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="{DynamicResource S_AboutDesc}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Content="{DynamicResource S_BtnGitHubRepo}"
                                                   Icon="{ui:SymbolIcon Globe20}"
                                                   Appearance="Secondary"
                                                   Margin="0,0,8,0"
                                                   Click="OpenGitHub_Click" />
                                        <ui:Button Content="{DynamicResource S_BtnCheckUpdates}"
                                                   Icon="{ui:SymbolIcon ArrowDownload20}"
                                                   Appearance="Primary"
                                                   Click="OpenReleases_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
