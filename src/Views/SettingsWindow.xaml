<ui:FluentWindow x:Class="LinkToBrowser.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="LinkToBrowser 设置"
                 Width="920"
                 Height="640"
                 MinWidth="800"
                 MinHeight="520"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="LinkToBrowser" ShowMaximize="True" ShowMinimize="True" Height="38" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航栏 -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="10,8,10,12">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top">
                        <ui:Button x:Name="NavGeneralBtn"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Content="常规"
                                   Icon="{ui:SymbolIcon Settings20}"
                                   Appearance="Secondary"
                                   Margin="0,0,0,4"
                                   Click="NavGeneral_Click" />
                        <ui:Button x:Name="NavBrowsersBtn"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Content="浏览器"
                                   Icon="{ui:SymbolIcon Globe20}"
                                   Appearance="Transparent"
                                   Margin="0,0,0,4"
                                   Click="NavBrowsers_Click" />
                        <ui:Button x:Name="NavAboutBtn"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Content="关于"
                                   Icon="{ui:SymbolIcon Info20}"
                                   Appearance="Transparent"
                                   Click="NavAbout_Click" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <Separator Margin="4,0,4,8" />
                        <ui:Button HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Content="打开配置文件"
                                   Icon="{ui:SymbolIcon Open20}"
                                   Appearance="Transparent"
                                   Margin="0,0,0,4"
                                   Click="OpenConfig_Click" />
                        <ui:Button HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Content="打开日志目录"
                                   Icon="{ui:SymbolIcon FolderOpen20}"
                                   Appearance="Transparent"
                                   Click="OpenLogs_Click" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 右侧设置主体 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="24,10,24,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PageTitleText" Text="常规" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="SavedBadgeText"
                               Grid.Column="1"
                               Text="已自动保存"
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Opacity="0" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,4,24,24">
                    <Grid>
                        <!-- 页 1：常规 -->
                        <StackPanel x:Name="GeneralPage">
                            <ui:InfoBar x:Name="RegStatusBar" IsOpen="True" IsClosable="False" Margin="0,0,0,12" />

                            <Border CornerRadius="8"
                                    Padding="16,12"
                                    Margin="0,0,0,18"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="系统默认浏览器接管" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock x:Name="RegPathSubtitle"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ui:Button x:Name="RegisterBtn"
                                               Grid.Column="1"
                                               Content="注册 / 更新路径"
                                               Appearance="Primary"
                                               Margin="0,0,8,0"
                                               Click="Register_Click" />
                                    <ui:Button Grid.Column="2"
                                               Content="打开默认应用设置"
                                               Appearance="Secondary"
                                               Click="OpenDefaultApps_Click" />
                                </Grid>
                            </Border>

                            <TextBlock Text="全局链接处理模式" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />

                            <!-- 模式 1：Windows 原生 -->
                            <Border CornerRadius="8"
                                    Padding="14,11"
                                    Margin="0,0,0,6"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    MouseLeftButtonUp="ModeNativeCard_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="ModeNativeRadio"
                                                 Grid.Column="0"
                                                 HorizontalContentAlignment="Stretch"
                                                 GroupName="GlobalMode"
                                                 Checked="ModeRadio_Changed">
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock Text="Windows 原生" FontWeight="SemiBold" FontSize="13.5" />
                                            <TextBlock Text="静默转发给系统原默认浏览器，0 风险且随时可彻底恢复"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <ComboBox x:Name="OriginalProgIdCombo"
                                              Grid.Column="1"
                                              Width="185"
                                              MaxWidth="185"
                                              Margin="8,0,8,0"
                                              VerticalAlignment="Center"
                                              DisplayMemberPath="Display"
                                              SelectionChanged="OriginalProgIdCombo_SelectionChanged" />
                                    <ui:Button Grid.Column="2"
                                               Content="彻底交还…"
                                               Appearance="Secondary"
                                               VerticalAlignment="Center"
                                               Click="RestoreSystemDefault_Click" />
                                </Grid>
                            </Border>

                            <!-- 模式 2：默认指定浏览器 -->
                            <Border CornerRadius="8"
                                    Padding="14,11"
                                    Margin="0,0,0,6"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    MouseLeftButtonUp="ModeDefaultCard_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="ModeDefaultRadio"
                                                 Grid.Column="0"
                                                 HorizontalContentAlignment="Stretch"
                                                 GroupName="GlobalMode"
                                                 Checked="ModeRadio_Changed">
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock Text="默认指定浏览器" FontWeight="SemiBold" FontSize="13.5" />
                                            <TextBlock Text="直接用下方指定的浏览器或自定义内核静默打开链接"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <ComboBox x:Name="DefaultBrowserCombo"
                                              Grid.Column="1"
                                              Width="210"
                                              MaxWidth="210"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              DisplayMemberPath="Name"
                                              SelectionChanged="DefaultBrowserCombo_SelectionChanged" />
                                </Grid>
                            </Border>

                            <!-- 模式 3：弹出浏览器选择界面 -->
                            <Border CornerRadius="8"
                                    Padding="14,11"
                                    Margin="0,0,0,6"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    MouseLeftButtonUp="ModePickerCard_Click">
                                <RadioButton x:Name="ModePickerRadio"
                                             HorizontalContentAlignment="Stretch"
                                             GroupName="GlobalMode"
                                             Checked="ModeRadio_Changed">
                                    <StackPanel Margin="4,0,0,0">
                                        <TextBlock Text="弹出浏览器选择界面" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock Text="每次点击链接在光标附近弹出选择小窗，支持 1–9 快选与即时过滤"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </RadioButton>
                            </Border>

                            <!-- 模式 4：默认复制到剪贴板 -->
                            <Border CornerRadius="8"
                                    Padding="14,11"
                                    Margin="0,0,0,16"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    MouseLeftButtonUp="ModeClipboardCard_Click">
                                <RadioButton x:Name="ModeClipboardRadio"
                                             HorizontalContentAlignment="Stretch"
                                             GroupName="GlobalMode"
                                             Checked="ModeRadio_Changed">
                                    <StackPanel Margin="4,0,0,0">
                                        <TextBlock Text="默认复制到剪贴板" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock Text="截断链接并写入剪贴板（3 秒重试与失败还原），适合配合指纹浏览器"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </RadioButton>
                            </Border>

                            <TextBlock Text="行为与外观" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />

                            <ui:CardControl Margin="0,0,0,6">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="剪贴板模式显示确认弹窗" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock Text="关闭后将完全静默写入剪贴板，仅在复制失败时弹窗提示"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="ShowClipPopupToggle" Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,6">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="剪贴板确认窗自动关闭时间" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock Text="鼠标悬停或焦点在链接框时自动暂停倒计时（0 表示不自动关闭）"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox x:Name="AutoCloseCombo" Width="150" SelectionChanged="AutoCloseCombo_SelectionChanged" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,6">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="修饰键临时弹出选择窗" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock Text="在非弹窗模式下，按住该键点击链接将临时改弹浏览器选择窗"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox x:Name="ModifierCombo" Width="150" SelectionChanged="ModifierCombo_SelectionChanged" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,6">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="发现 Chromium 多用户配置" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock Text="自动列出 Chrome / Edge 等多账号 Profile 入口"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="ChromiumProfilesToggle" Checked="ChromiumProfilesToggle_Changed" Unchecked="ChromiumProfilesToggle_Changed" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,6">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="清理常见追踪参数" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock Text="移除查询串中的 utm_*、fbclid、gclid、msclkid、spm（保留 # 锚点与原编码）"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="StripTrackingToggle" Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                            </ui:CardControl>

                            <ui:CardControl>
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="界面主题" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock Text="默认跟随 Windows 11 系统深浅色设置"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox x:Name="ThemeCombo" Width="150" SelectionChanged="ThemeCombo_SelectionChanged" />
                            </ui:CardControl>
                        </StackPanel>

                        <!-- 页 2：浏览器管理 -->
                        <StackPanel x:Name="BrowsersPage" Visibility="Collapsed">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="支持上下调整排序、隐藏不想在选择窗出现的程序，以及添加任意指纹浏览器内核或带参启动项。"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0" />
                                <ui:Button Grid.Column="1"
                                           Content="重新扫描"
                                           Icon="{ui:SymbolIcon ArrowSync20}"
                                           Appearance="Secondary"
                                           Margin="0,0,8,0"
                                           Click="RescanBrowsers_Click" />
                                <ui:Button Grid.Column="2"
                                           Content="添加自定义浏览器"
                                           Icon="{ui:SymbolIcon Add20}"
                                           Appearance="Primary"
                                           Click="AddCustomBrowser_Click" />
                            </Grid>

                            <ItemsControl x:Name="BrowsersListControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8"
                                                Padding="12,10"
                                                Margin="0,0,0,6"
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Column="0" Width="22" Height="22" VerticalAlignment="Center">
                                                    <Image Source="{Binding Icon}" Width="22" Height="22" />
                                                    <ui:SymbolIcon Symbol="Globe20" Visibility="{Binding FallbackIconVisibility}" />
                                                </Grid>

                                                <StackPanel Grid.Column="1" Margin="8,0,12,0" VerticalAlignment="Center">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                                        <Border Grid.Column="1"
                                                                CornerRadius="4"
                                                                Padding="6,1"
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                            <TextBlock Text="{Binding KindLabel}" FontSize="11" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding CommandPreview}"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding CommandPreview}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:Button Icon="{ui:SymbolIcon ArrowUp20}"
                                                               Appearance="Transparent"
                                                               ToolTip="上移"
                                                               Tag="{Binding}"
                                                               Click="MoveUp_Click" />
                                                    <ui:Button Icon="{ui:SymbolIcon ArrowDown20}"
                                                               Appearance="Transparent"
                                                               ToolTip="下移"
                                                               Tag="{Binding}"
                                                               Margin="0,0,4,0"
                                                               Click="MoveDown_Click" />
                                                    <ui:Button Content="{Binding VisibilityButtonText}"
                                                               Appearance="Secondary"
                                                               Tag="{Binding}"
                                                               Margin="0,0,4,0"
                                                               Click="ToggleHidden_Click" />
                                                    <ui:Button Content="测试"
                                                               Appearance="Secondary"
                                                               Tag="{Binding}"
                                                               Margin="0,0,4,0"
                                                               Click="TestBrowser_Click" />
                                                    <ui:Button Icon="{ui:SymbolIcon Edit20}"
                                                               Appearance="Transparent"
                                                               ToolTip="编辑"
                                                               Visibility="{Binding CustomActionVisibility}"
                                                               Tag="{Binding}"
                                                               Click="EditCustom_Click" />
                                                    <ui:Button Icon="{ui:SymbolIcon Delete20}"
                                                               Appearance="Transparent"
                                                               ToolTip="删除"
                                                               Visibility="{Binding CustomActionVisibility}"
                                                               Tag="{Binding}"
                                                               Click="DeleteCustom_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- 页 3：关于与诊断 -->
                        <StackPanel x:Name="AboutPage" Visibility="Collapsed">
                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="系统当前关联诊断 (UserChoice)" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock x:Name="DiagAssocText"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:Button Content="刷新" Appearance="Secondary" Click="RefreshDiag_Click" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="配置文件位置" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock x:Name="DiagConfigPathText"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:Button Content="打开" Appearance="Secondary" Click="OpenConfig_Click" />
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="运行日志目录" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock x:Name="DiagLogDirText"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="打开目录" Appearance="Secondary" Margin="0,0,8,0" Click="OpenLogs_Click" />
                                    <ui:Button Content="清空日志" Appearance="Secondary" Click="ClearLogs_Click" />
                                </StackPanel>
                            </ui:CardControl>

                            <ui:CardControl Margin="0,0,0,8">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="彻底交还系统默认状态" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock Text="打开 Windows 默认应用设置页选回原浏览器，并可安全清理 HKCU 注册项"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:Button Content="还原并清理注册..." Appearance="Caution" Click="RestoreSystemDefault_Click" />
                            </ui:CardControl>

                            <Border CornerRadius="8"
                                    Padding="16,12"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="LinkToBrowser v2.0.0" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="免安装、0 风险、面向多浏览器与指纹浏览器的轻量 Windows 11 链接分流与剪贴板工具（MIT License）。"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
