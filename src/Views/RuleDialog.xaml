<ui:FluentWindow x:Class="LinkToBrowser.Views.RuleDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource S_RuleWinTitle}"
                 Icon="pack://application:,,,/LinkToBrowser;component/src/Assets/LinkToBrowser.ico"
                 Width="520"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{DynamicResource S_RuleTitleBar}"
                     Icon="{ui:ImageIcon 'pack://application:,,,/LinkToBrowser;component/src/Assets/LinkToBrowser.png'}"
                     ShowMaximize="False"
                     ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="20,8,20,20">
            <TextBlock Text="{DynamicResource S_RuleNameLabel}" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ui:TextBox x:Name="NameBox" PlaceholderText="{DynamicResource S_RuleNameHint}" Margin="0,0,0,12" />

            <TextBlock Text="{DynamicResource S_RuleMatchKindLabel}" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ComboBox x:Name="MatchKindCombo" Margin="0,0,0,12" />

            <TextBlock Text="{DynamicResource S_RulePatternLabel}" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ui:TextBox x:Name="PatternBox"
                        PlaceholderText="{DynamicResource S_RulePatternHint}"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="64"
                        MaxHeight="120"
                        VerticalScrollBarVisibility="Auto"
                        Margin="0,0,0,8" />

            <WrapPanel Margin="0,0,0,12">
                <ui:Button Content="{DynamicResource S_RulePresetLocal}" Appearance="Secondary" Margin="0,0,8,0" Click="PresetLocal_Click" />
                <ui:Button Content="{DynamicResource S_RulePresetGitHub}" Appearance="Secondary" Margin="0,0,8,0" Click="PresetGitHub_Click" />
                <ui:Button Content="{DynamicResource S_RulePresetOAuth}" Appearance="Secondary" Click="PresetOAuth_Click" />
            </WrapPanel>

            <TextBlock Text="{DynamicResource S_RuleActionLabel}" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ComboBox x:Name="ActionCombo" Margin="0,0,0,12" SelectionChanged="ActionCombo_SelectionChanged" />

            <StackPanel x:Name="TargetBrowserPanel" Margin="0,0,0,12">
                <TextBlock Text="{DynamicResource S_RuleTargetLabel}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ComboBox x:Name="TargetBrowserCombo" DisplayMemberPath="Name" />
            </StackPanel>

            <ui:InfoBar x:Name="ErrorBar" IsOpen="False" IsClosable="False" Severity="Error" Margin="0,0,0,12" />

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="1" Content="{DynamicResource S_CustomCancel}" Margin="0,0,8,0" Click="Cancel_Click" />
                <ui:Button Grid.Column="2" Content="{DynamicResource S_CustomSave}" Appearance="Primary" Click="Save_Click" />
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
