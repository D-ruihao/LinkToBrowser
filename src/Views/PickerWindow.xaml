<ui:FluentWindow x:Class="LinkToBrowser.Views.PickerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="选择浏览器"
                 Width="450"
                 SizeToContent="Height"
                 MaxHeight="560"
                 ResizeMode="NoResize"
                 Topmost="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="LinkToBrowser · 选择打开方式" ShowMaximize="False" ShowMinimize="False" Height="36" />

        <StackPanel Grid.Row="1" Margin="16,4,16,16">
            <ui:InfoBar x:Name="WarningBar"
                        IsOpen="False"
                        IsClosable="False"
                        Severity="Warning"
                        Margin="0,0,0,10" />

            <Border CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,10"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="HostText" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="UrlPreviewText"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <ui:Button x:Name="CopyBtn"
                               Grid.Column="1"
                               Content="复制"
                               Icon="{ui:SymbolIcon Copy20}"
                               Appearance="Secondary"
                               ToolTip="复制链接到剪贴板 (Ctrl+C)"
                               Margin="0,0,6,0"
                               Click="CopyBtn_Click" />
                    <ui:Button Grid.Column="2"
                               Icon="{ui:SymbolIcon Settings20}"
                               Appearance="Transparent"
                               ToolTip="打开 LinkToBrowser 设置"
                               Click="SettingsBtn_Click" />
                </Grid>
            </Border>

            <ui:TextBox x:Name="SearchBox"
                        Icon="{ui:SymbolIcon Search20}"
                        PlaceholderText="输入筛选浏览器，或直接按 1–9 快选..."
                        Margin="0,0,0,10"
                        TextChanged="SearchBox_TextChanged" />

            <ListBox x:Name="BrowserList"
                     MaxHeight="300"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Background="Transparent"
                     BorderThickness="0"
                     PreviewMouseLeftButtonUp="BrowserList_PreviewMouseLeftButtonUp">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,3" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="20"
                                    Height="20"
                                    CornerRadius="4"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    Visibility="{Binding BadgeVisibility}">
                                <TextBlock Text="{Binding HotkeyText}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </Border>

                            <Grid Grid.Column="1" Width="20" Height="20" VerticalAlignment="Center">
                                <Image Source="{Binding Icon}" Width="20" Height="20" />
                                <ui:SymbolIcon Symbol="Globe20" Visibility="{Binding FallbackIconVisibility}" />
                            </Grid>

                            <StackPanel Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel x:Name="EmptyStatePanel" Visibility="Collapsed" Margin="0,16,0,8" HorizontalAlignment="Center">
                <TextBlock Text="没有找到可用的浏览器条目"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,10" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ui:Button Content="复制链接" Appearance="Primary" Margin="0,0,8,0" Click="CopyBtn_Click" />
                    <ui:Button Content="打开设置" Appearance="Secondary" Click="SettingsBtn_Click" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
