<ui:FluentWindow x:Class="LinkToBrowser.Views.ClipboardWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="LinkToBrowser"
                 Icon="pack://application:,,,/LinkToBrowser;component/src/Assets/LinkToBrowser.ico"
                 Width="640"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 Topmost="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 PreviewKeyDown="Window_PreviewKeyDown"
                 MouseEnter="Window_MouseEnter"
                 MouseLeave="Window_MouseLeave">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{DynamicResource S_ClipTitleBar}"
                     Icon="{ui:ImageIcon 'pack://application:,,,/LinkToBrowser;component/src/Assets/LinkToBrowser.png'}"
                     ShowMaximize="False"
                     ShowMinimize="False"
                     Height="36" />

        <StackPanel Grid.Row="1" Margin="16,4,16,16">
            <ui:InfoBar x:Name="StatusBar" IsOpen="True" IsClosable="False" Margin="0,0,0,10" />

            <ui:TextBox x:Name="UrlBox"
                        IsReadOnly="True"
                        IsInactiveSelectionHighlightEnabled="True"
                        Margin="0,0,0,12"
                        GotKeyboardFocus="UrlBox_GotKeyboardFocus"
                        LostKeyboardFocus="UrlBox_LostKeyboardFocus" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="0"
                           Content="{DynamicResource S_ClipCopyAgain}"
                           Icon="{ui:SymbolIcon Copy20}"
                           Appearance="Primary"
                           Margin="0,0,8,0"
                           Click="CopyAgain_Click" />
                <ui:Button Grid.Column="1"
                           Content="{DynamicResource S_ClipOpenBrowser}"
                           Icon="{ui:SymbolIcon Globe20}"
                           Appearance="Secondary"
                           Margin="0,0,8,0"
                           Click="OpenInBrowser_Click" />
                <ui:Button Grid.Column="2"
                           Content="{DynamicResource S_ClipLogs}"
                           Icon="{ui:SymbolIcon FolderOpen20}"
                           Appearance="Secondary"
                           Click="OpenLogs_Click" />

                <ui:Button Grid.Column="4"
                           Icon="{ui:SymbolIcon Settings20}"
                           Appearance="Transparent"
                           ToolTip="{DynamicResource S_ClipSettingsTip}"
                           Margin="0,0,6,0"
                           Click="OpenSettings_Click" />
                <ui:Button x:Name="CloseBtn"
                           Grid.Column="5"
                           Content="{DynamicResource S_ClipClose}"
                           Click="Close_Click" />
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
