<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>11.0</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>src\Assets\LinkToBrowser.ico</ApplicationIcon>
    <StartupObject>LinkToBrowser.Program</StartupObject>
    <EnableDefaultItems>false</EnableDefaultItems>
    <AssemblyName>LinkToBrowser</AssemblyName>
    <RootNamespace>LinkToBrowser</RootNamespace>
    <Version>2.0.1</Version>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Compile Include="src\**\*.cs" />
    <Page Include="src\**\*.xaml" />
    <Resource Include="src\Assets\LinkToBrowser.ico" />
    <Resource Include="src\Assets\LinkToBrowser.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="WPF-UI" Version="3.0.5" />
  </ItemGroup>
</Project>
